# Copy this file to .env and fill in the values from your Supabase project.
# Supabase dashboard > your project > Connect (or Project Settings > API Keys).
# These two values are designed to be public; Row Level Security protects the data.
# Never put the secret key or database password here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# RevenueCat dashboard > your project > API keys: the public SDK key for each app.
# These are public keys too. Never put a RevenueCat secret key (sk_...) here.
# Leave them empty and the app runs as Free, with the paywall saying Pro isn't available yet.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_key_here
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_key_here
# Optional, development only: the Test Store key (test_...). Expo Go needs this one, because it
# can't reach the real stores. Remove it to test real store purchases in a development build.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=

# Development only. Expo Go is always a dev build, so testers would see the
# "Testing as" plan override and "Restart 8-week block" without this extra flag.
# Set to true and restart the bundler when you want those controls.
EXPO_PUBLIC_SHOW_DEV_TOOLS=

# PostHog (EU). Project API key from PostHog > Project settings. This is a public
# project token (phc_...), not a personal API key. Leave empty and the app still
# opens; events are not sent. Restart Expo after changing these.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
