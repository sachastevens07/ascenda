# Copy this file to .env and fill in the values from your Supabase project.
# Supabase dashboard > your project > Connect (or Project Settings > API Keys).
# These two values are designed to be public; Row Level Security protects the data.
# Never put the secret key or database password here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
