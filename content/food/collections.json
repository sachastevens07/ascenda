  "training_suggestions": {
    "_how": "F4: one suggestion at most, shown on the Home hero after a session and on the post-session wins screen. Never framed as a requirement or a reward for training.",
    "rules": [
      {
        "if": "session.type == 'strength' and day.name starts with 'Lower' or 'Glutes' or 'Full body'",
        "collection": "after-leg-day",
        "copy": "Fuel for later: a dinner with protein and carbs"
      },
      {
        "if": "session.type == 'strength'",
        "collection": "strong-and-nourished",
        "copy": "Fuel for later: something balanced and filling"
      },
      {
        "if": "planned_session.reminder_time >= 17:00 and now < 15:00",
        "collection": "before-an-evening-session",
        "copy": "Training this evening? A lighter bite a couple of hours before helps",
        "placement": "home_hero_before_session"
      },
      {
        "if": "session.type in ['cardio','recovery']",
        "collection": "strong-and-nourished",
        "copy": "Fuel for later: something balanced and filling"
      }
    ],
    "routine_day_recipe_suggestions": "Optional per routine day override, for example a glute day pointing at 'after-leg-day'. Not needed at launch; the rules above cover it.",
    "respect": [
      "profiles.hide_macros hides nutrition, never suggestions",
      "Never mention calories, earning food or making up for food"
    ]
  }
}