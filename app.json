{
  "expo": {
    "name": "Evoluma",
    "slug": "womens-strength",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "womensstrength",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "app.evoluma",
      "infoPlist": {},
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5C3A4E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Your photo library is only used if you choose to add a private progress photo.",
          "cameraPermission": "Your camera is only used if you choose to take a private progress photo."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Your camera is only used if you choose to take a private progress photo.",
          "recordAudioAndroid": false
        }
      ],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#FFFCF8"
        }
      ],
      "expo-video",
      "expo-image",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "495726ab-821a-4018-932f-c56a2758647c"
      },
      "google": {
        "_note": "Google sign-in client IDs from Google Cloud (not secret). Leave empty to hide the Google button. Changing them needs a new build.",
        "iosClientId": "",
        "webClientId": ""
      }
    },
    "owner": "sachstev"
  }
}
