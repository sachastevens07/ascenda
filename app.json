{
  "expo": {
    "name": "Strivella",
    "slug": "womens-strength",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "womensstrength",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Your photo library is only used if you choose to add a private progress photo.",
          "cameraPermission": "Your camera is only used if you choose to take a private progress photo."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Your camera is only used if you choose to take a private progress photo.",
          "recordAudioAndroid": false
        }
      ],
      "expo-localization",
      "expo-splash-screen",
      "expo-video",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
